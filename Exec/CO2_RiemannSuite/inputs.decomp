# =====================================================================
#  Two-phase CO2 DECOMPRESSION-WAVE validation (task #85 level-b payoff).
#
#  A two-phase CO2 column (left, high P, quality ~0.5 -> large frozen/Wood
#  sound-speed gap) decompressed into low-P vapor (right).  A rarefaction
#  propagates LEFT into the two-phase region; its LEADING-EDGE speed is the
#  local sound speed.  As the pressure-relaxation time tau_p (mode-3) is
#  swept, the effective front speed should transition between the
#  EQUILIBRIUM (Wood, slow; tau_p->0) and FROZEN (fast; tau_p->inf) limits
#  -- the dispersive signature that finite-rate pressure relaxation +
#  two-pressure flux (CAMR.ps_pk_energy_flux=1) captures and instantaneous
#  mechanical equilibrium cannot.  This is the CO2-pipeline decompression-
#  wave-speed physics (fracture-arrest design).
#
#  Run (single build, three tau_p) e.g.:
#   EQUILIB:  CAMR.ps_relax_mode=1                         (instant P+T eq)
#   FROZEN :  CAMR.ps_relax_mode=3 CAMR.ps_p_tau=1.0 CAMR.ps_theta_tau=1.0 \
#             CAMR.ps_pk_energy_flux=1                     (P relax ~ frozen)
#   FINITE :  CAMR.ps_relax_mode=3 CAMR.ps_p_tau=1e-4 CAMR.ps_theta_tau=1e-4 \
#             CAMR.ps_pk_energy_flux=1                     (dispersive)
#  Bounds:   CAMR.ps_csound_report=1 max_step=0  -> prints c_frozen, c_wood
#            at the left two-phase state (the analytic front-speed limits).
# =====================================================================
max_step  = 100000
stop_time = 5.0e-4

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     =   0.0    0.0        0.0
geometry.prob_hi     =   1.0    0.0078125  0.0078125
amr.n_cell           =   512    2          2

CAMR.lo_bc = SlipWall SlipWall SlipWall
CAMR.hi_bc = Inflow    SlipWall SlipWall

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0
CAMR.ps_alpha_vanish = 1.0e-8

# Relaxation defaults (overridden per run above).  mode-1 = equilibrium ref.
CAMR.ps_do_relax   = 1
CAMR.ps_relax_mode = 1
CAMR.ps_p_tau      = 0.0
CAMR.ps_theta_tau  = 0.0
CAMR.ps_mt_tau     = 0.0        # MT off: isolate the acoustic (P) response
CAMR.ps_pres_floor = 1.0e4
CAMR.ps_temp_floor = 216.6

amr.max_level   = 0
amr.v = 0
CAMR.v = 1
amr.plot_int    = -1            # set on cmd line; plot at 2 times for speed
amr.plot_file   = plt_dcmp
amr.checkpoint_files_output = 0

# --- Two-phase decompression Riemann IC ---
prob.phase_L  = 3              # PS_PHASE_TWOPHASE: saturated two-phase at Psat(T_L)
prob.p_L      = 4.0e6           # (ignored for TWOPHASE; state set at Psat(T_L)~41.6 bar)
prob.T_L      = 280.0
prob.u_L      = 0.0
prob.x_qual_L = 0.5            # 50/50 MASS quality -> alpha1~0.13, large c_frozen/c_wood gap
prob.phase_R  = 0
prob.p_R      = 1.0e6           # low-P vapor -> strong left-going rarefaction
prob.T_R      = 280.0
prob.u_R      = 0.0
prob.x_qual_R = 1.0
prob.alpha_trace = 1.0e-6
prob.x_diaph  = 0.7            # room on the left for the rarefaction to travel
prob.p_amb    = 1.0e6
