# =====================================================================
#  CO2_B4 — cross-critical Riemann fan across a static coarse-fine face
#
#  1-D-in-x B4 (liquid 270 K / 100 bar left, supercritical 350 K / 50 bar
#  right, diaphragm at x = 0.5) on a 256 x 32 base grid with ONE static
#  level-1 box over x in [0.30, 0.50] (a pure geometric box tag, re-tagged
#  every regrid, so it never moves).  The rarefaction head starts at the
#  diaphragm on the fine edge of the box and runs left through the
#  coarse-fine face at x = 0.30 into the coarse grid, so whatever the
#  reflux of the non-conservative content (wp-alpha, phase-energy defect)
#  leaves behind appears at a known place, isolated from feature
#  tracking.  Relaxation, mass transfer and flash are off so the hydro
#  path alone is measured.  Compare against a uniform-fine run at the
#  same time.
# =====================================================================

amrex.fpe_trap_invalid = 0

max_step  = 5000
stop_time = 7.339590e-04

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     =   0.0    0.0
geometry.prob_hi     =   1.0    0.125
amr.n_cell           =   256    32

CAMR.lo_bc = Inflow SlipWall
CAMR.hi_bc = Inflow SlipWall

CAMR.cfl = 0.25
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1

CAMR.do_mol   = 0
CAMR.ppm_type = 1

CAMR.ps_hydro        = 1
#  wp (the compiled default) at second order (ps_wp_order defaults to
#  1; 2 is the acceptance configuration); relaxation, mass transfer and
#  flash off.
CAMR.ps_flux         = wp
CAMR.ps_wp_order     = 2
CAMR.ps_do_relax     = 0
CAMR.ps_mt_tau       = 0    # no mass transfer
CAMR.ps_flash_tau    = 0    # no flash source
CAMR.ps_bc_use_nscbc = 0

CAMR.v = 1
amr.v  = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

# --- 2-level AMR with a static refine box x in [0.30, 0.50] ----------
amr.max_level       = 1
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 4
amr.max_grid_size   = 64
amr.n_error_buf     = 0 0 0 0
amr.grid_eff        = 0.99
DistributionMapping.strategy = ROUNDROBIN

# Geometric fixed-box tag: a BOX test with no field criterion tags exactly
# the real box [0.30, 0.50] x [full y].  CAMR_error.cpp uses the BOX
# AMRErrorTag when only in_box_lo/hi are given, so the refined region is
# static and does not track the waves.
amr.refinement_indicators = fbox
amr.fbox.in_box_lo = 0.30 0.0
amr.fbox.in_box_hi = 0.50 0.125
amr.fbox.max_level = 1

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = pltfb
amr.plot_int          = 100000
amr.derive_plot_vars  = x_velocity y_velocity pressure vfrac

# --- Problem initial state (SI) --------------------------------------
prob.p_L = 1.0e7
prob.T_L = 270.0
prob.u_L = 0.0
prob.p_R = 5.0e6
prob.T_R = 350.0
prob.u_R = 0.0
prob.x_diaph = 0.5
