# =====================================================================
#  CO2_B4 — FIXED-refinement-box C-F reflux probe (task #24)
#
#  STALLED CONTACT (task #35): equal pressure both sides, u=0, alpha:1->0
#  x in [0.4, 0.6] (held fixed via a pure geometric BOX tag, re-tagged
#  every regrid so it never moves).  The
#  rarefaction fan starts at the diaphragm (x=0.5, inside the box) and
#  its head propagates LEFT, crossing the coarse-fine boundary at x=0.4
#  into the coarse grid; the shock crosses x=0.6.  As the non-conservative
#  WP-α / phase-energy-defect content crosses the fixed C-F face, the
#  reflux gap produces a signal at a KNOWN location (x=0.3, 0.7) that is
#  isolated from feature-tracking — usable as a C-F reflux success metric.
#  Compare vs a uniform-fine reference at the same time.
# =====================================================================

amrex.fpe_trap_invalid = 0

max_step  = 5000
stop_time = 7.339590e-04

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     =   0.0    0.0
geometry.prob_hi     =   1.0    0.125
amr.n_cell           =   256    32

CAMR.lo_bc = Inflow SlipWall
CAMR.hi_bc = Inflow SlipWall

CAMR.cfl = 0.25
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1

CAMR.do_mol   = 0
CAMR.ppm_type = 1

CAMR.ps_hydro        = 1
CAMR.ps_flux         = hllc
CAMR.ps_recon        = 0
CAMR.ps_do_relax     = 0
CAMR.ps_mt_tau       = 0    # no mass transfer (pre-2026-08-24 default, pinned)
CAMR.ps_flash_tau    = 0    # no flash source  (pre-2026-08-24 default, pinned)
CAMR.ps_bc_use_nscbc = 0

CAMR.v = 1
amr.v  = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

# --- 2-level AMR with a STATIC refine box x in [0.3,0.7] -------------
amr.max_level       = 1
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 4
amr.max_grid_size   = 64
amr.n_error_buf     = 0 0 0 0
amr.grid_eff        = 0.99
DistributionMapping.strategy = ROUNDROBIN

# Geometric fixed-box tag: BOX test (no field criterion) → tags exactly
# the realbox [0.3,0.7] x [full y].  CAMR_error.cpp uses the BOX/default
# AMRErrorTag when only in_box_lo/hi are given (no value_greater etc.),
# so this is a STATIC refined box that does NOT track the waves.
amr.refinement_indicators = fbox
amr.fbox.in_box_lo = 0.30 0.0
amr.fbox.in_box_hi = 0.50 0.125
amr.fbox.max_level = 1

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = pltfb
amr.plot_int          = 100000
amr.derive_plot_vars  = x_velocity y_velocity pressure vfrac

# --- Problem initial state (SI) --------------------------------------
prob.p_L = 6.0e6
prob.T_L = 270.0
prob.u_L = 0.0
prob.p_R = 6.15e6
prob.T_R = 350.0
prob.u_R = 0.0
prob.x_diaph = 0.5
