# =====================================================================
#  CO2_B4 — cross-critical CO2 Riemann problem (B4), uniform grid
#
#  The standalone suite's B4-Cross-critical case in the 2-D build:
#     L (x < 0.5):  T = 270 K, P = 100 bar, u = 0   (liquid CO2)
#     R (x > 0.5):  T = 350 K, P =  50 bar, u = 0   (supercritical)
#     t_final = 7.339590e-04 s (734 us)
#
#  Domain: 1 m in x, thin slice in y; 512 x 64 cells, no AMR, CFL 0.25,
#  wp at the compiled defaults (ps_wp_order 1), relaxation on.  Both x faces are Inflow
#  so bcnormal (prob.H) applies the per-side non-reflecting outflow with
#  p_amb_lo = p_L on the low face and p_amb_hi = p_R on the high face;
#  y is SlipWall.  The third entry of the geometry and n_cell lines is
#  read only by a 3-D build.
#
#  Grid-convergence sweep (override on the command line):
#     amr.n_cell = 256 32 32
#     amr.n_cell = 512 64 32
#     amr.n_cell = 1024 128 32
#     amr.n_cell = 2048 128 32
# =====================================================================

amrex.fpe_trap_invalid = 0

# The fan stays well inside the domain at stop_time; max_step is a
# generous cap that never governs.
max_step  = 5000
stop_time = 7.339590e-04

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0

geometry.prob_lo     =   0.0    0.0    0.0
geometry.prob_hi     =   1.0    0.125  0.125
amr.n_cell           =   512    64     32

# Two-face non-reflecting outflow: bcnormal (prob.H) branches on the
# face sign to pick p_amb_lo or p_amb_hi.  y (and z) are SlipWall.
CAMR.lo_bc = Inflow SlipWall SlipWall
CAMR.hi_bc = Inflow SlipWall SlipWall

CAMR.cfl = 0.25
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1

CAMR.do_mol = 0
CAMR.ppm_type = 1

# PS hydro at the compiled defaults (wp, ps_wp_order 1); the interior
# scheme is not selectable, the order is (CAMR.ps_wp_order = 2 is the
# acceptance configuration used by the 1-D suite).
CAMR.ps_hydro = 1

# The characteristic (NSCBC) outflow is off: the bcnormal path above
# already carries the two different ambient pressures this case needs.
# With ps_bc_use_nscbc = 1 the per-face targets come from
# CAMR.ps_bc_p_amb_{x}{lo,hi} (inheriting prob.p_amb when unset).
CAMR.ps_bc_use_nscbc = 0
CAMR.ps_bc_nscbc_sigma = 0.25

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

amr.loadbalance_with_workestimates = 0
amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 2
amr.max_grid_size   = 32
amr.n_error_buf     = 0 0 0 0
amr.grid_eff        = 0.99

DistributionMapping.strategy = ROUNDROBIN

amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = 500

amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 50000
amr.derive_plot_vars  = x_velocity y_velocity z_velocity vfrac pressure

# --- Problem initial state (SI units) ---------------------------------
prob.p_L      = 1.0e7    # Pa    (100 bar)
prob.T_L      = 270.0    # K
prob.u_L      = 0.0      # m/s

prob.p_R      = 5.0e6    # Pa    (50 bar)
prob.T_R      = 350.0    # K
prob.u_R      = 0.0      # m/s

prob.x_diaph  = 0.5      # fraction of x-extent (→ midpoint of 1-m tube)

# Single ambient pressure for the NSCBC path (CAMR.ps_bc_use_nscbc = 1
# with no per-face CAMR.ps_bc_p_amb_* set); the bcnormal path ignores it.
prob.p_amb    = 5.0e6
