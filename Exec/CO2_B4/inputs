# =====================================================================
#  CO2_B4 — cross-critical CO2 Riemann problem
#
#  Port of the standalone driver's B4-Cross-critical case.
#     L (x < 0.5):  T = 270 K, P = 100 bar, u = 0   (liquid CO2)
#     R (x > 0.5):  T = 350 K, P =  50 bar, u = 0   (supercritical)
#     t_final = 7.339590e-04 s (734 μs)
#
#  Domain: 1 m in x, thin slice in y, z.  Both x-faces are Inflow so
#  bcnormal dispatches to the per-face nonreflecting outflow.  y and z
#  are SlipWall (irrelevant for the 1-D-like Riemann setup).
#
#  Recommended sequence for the grid-convergence sweep (task #180):
#     amr.n_cell = 256 32 32   → coarse
#     amr.n_cell = 512 64 32
#     amr.n_cell = 1024 128 32
#     amr.n_cell = 2048 128 32 → fine
# =====================================================================

amrex.fpe_trap_invalid = 0

# Riemann fan should stop well short of the boundaries at t_final,
# but keep the run cap generous.
max_step  = 5000
stop_time = 7.339590e-04

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0

geometry.prob_lo     =   0.0    0.0    0.0
geometry.prob_hi     =   1.0    0.125  0.125
amr.n_cell           =   512    64     32

# Two-face nonreflecting outflow.  bcnormal (prob.H) branches on sgn
# to pick p_amb_lo vs p_amb_hi.  y and z stay SlipWall.
CAMR.lo_bc = Inflow SlipWall SlipWall
CAMR.hi_bc = Inflow SlipWall SlipWall

CAMR.cfl = 0.25
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1

CAMR.do_mol = 0
CAMR.ppm_type = 1

# PS hydro on with MUSCL reconstruction (default for production).
# For step-locked cross-code diagnostic runs matching the standalone
# driver's first-order default, override on the command line with
# CAMR.ps_recon=0.
CAMR.ps_hydro = 1
CAMR.ps_recon = 1

# PS-NSCBC currently supports only ONE ambient P per case (see prob.H
# NOTE).  For B4 with different L and R initial-state pressures, the
# sgn-aware bcnormal path is strictly more accurate.  Set this to 1
# only when the PS-NSCBC dispatch has been enhanced to carry
# per-face p_amb targets.
CAMR.ps_bc_use_nscbc = 0
CAMR.ps_bc_nscbc_sigma = 0.25

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

amr.loadbalance_with_workestimates = 0
amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 2
amr.max_grid_size   = 32
amr.n_error_buf     = 0 0 0 0
amr.grid_eff        = 0.99

DistributionMapping.strategy = ROUNDROBIN

amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = 500

amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 50000
amr.derive_plot_vars  = x_velocity y_velocity z_velocity vfrac pressure

# --- Problem initial state (SI units) ---------------------------------
prob.p_L      = 1.0e7    # Pa    (100 bar)
prob.T_L      = 270.0    # K
prob.u_L      = 0.0      # m/s

prob.p_R      = 5.0e6    # Pa    (50 bar)
prob.T_R      = 350.0    # K
prob.u_R      = 0.0      # m/s

prob.x_diaph  = 0.5      # fraction of x-extent (→ midpoint of 1-m tube)

# NSCBC-path fallback (single ambient).  Ignored by the sgn-aware
# bcnormal path.  Only used when CAMR.ps_bc_use_nscbc = 1.
prob.p_amb    = 5.0e6
