amrex.fpe_trap_invalid = 1

# Phase 2 defaults: clean supercritical CO₂ shock tube.
#   L: 350 K, 100 bar, u=0
#   R: 350 K,  10 bar, u=0
# Both sides supercritical (T > Tc = 304 K).  Domain 1.0 m; stop time
# picked so the fast wave reaches ~80 % of the domain.  Estimated
# wavefront speed ~ 300 m/s (real-fluid c_R ≈ 284 m/s + post-shock u
# contribution), so t ≈ 0.4 / 300 = 1.33e-3 s.
max_step  = 400
stop_time = 1.33e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical

geometry.prob_lo     =   0.0  0.0  0.0
geometry.prob_hi     =   1.0  1.0  1.0
amr.n_cell           =   200   32   32

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
CAMR.lo_bc       =  Outflow  NoSlipWall   SlipWall
CAMR.hi_bc       =  Outflow  NoSlipWall   SlipWall

CAMR.cfl = 0.3  # cfl number for hyperbolic system

# Use Godunov PPM
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.v = 2
amr.v = 1

CAMR.sum_interval = 1

CAMR.redistribution_type = FluxRedist
CAMR.redistribution_type = StateRedist

# LOAD BALANCE
amr.loadbalance_with_workestimates = 0

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 8
amr.max_grid_size   = 32
amr.n_error_buf     = 0 0 0 0
amr.grid_eff        = 0.99

# CHECKPOINT FILES
amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = 100

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 20
amr.derive_plot_vars  = x_velocity y_velocity z_velocity vfrac

amr.blocking_factor = 16
amr.max_grid_size   = 64

# CO2 shock-tube inputs — SI units, clean supercritical case.
prob.type  = 0
prob.p_l   = 1.0e7       # Pa  (100 bar)
prob.p_r   = 1.0e6       # Pa  ( 10 bar)
prob.T_l   = 350.0       # K   (both sides supercritical, T > Tc)
prob.T_r   = 350.0       # K
prob.u_l   = 0.0
prob.u_r   = 0.0
