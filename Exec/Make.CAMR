TOP ?= $(CAMR_HOME)

EBASE = CAMR

#Turn off all fortran in amrex
BL_NO_FORT = TRUE

include $(AMREX_HOME)/Tools/GNUMake/Make.defs

ifeq ($(USE_EB), TRUE)
  DEFINES += -DAMREX_USE_EB
  USERSuffix += .EB
endif

ifeq ($(USE_MOVING_EB), TRUE)
  DEFINES += -DCAMR_USE_MOVING_EB
endif

# Pelanti-Shyue six-equation hydro module (co2-eos-cfd Phase 4).
# Off by default; per-case opt-in via USE_PS_HYDRO := TRUE in the
# Exec GNUmakefile.  When set, the conservative state grows by 5
# components (α₁, α_k ρ_k, α_k ρ_k E_k) and the PelantiShyue Hydro
# module is compiled in.  See Source/Hydro/PelantiShyue/README.md .
# NOTE: the Bdirs += line belongs alongside the other Bdirs additions
# further down (after `Bdirs :=`); here we only set DEFINES + the
# suffix so build-output directories are separable.
ifeq ($(USE_PS_HYDRO), TRUE)
  DEFINES += -DUSE_PS_HYDRO
  USERSuffix += .PS
endif

all: $(executable)
ifneq ($(KEEP_BUILDINFO_CPP),TRUE)
	$(SILENT) $(RM) AMReX_buildInfo.cpp
endif
	@echo SUCCESS

# ---------------------------------------------------------------------
#  MLPx2 table EOS generation.
#
#  The bicubic PR table (mlpx2_table_data.cpp, ~6 MB) is NOT committed; the
#  repo carries only a tiny #error placeholder, so a build before the table
#  is generated fails early with a clear message.  Generate all three
#  branches (auto + liquid + vapor) with:   make tables
#  Requires a host g++ and python3 with numpy + scipy.  The generated files are
#  git-ignored; remove them (so the next build re-trips the guard) with:
#      make clean-tables
#  Neither is invoked by `make clean` / `make realclean`.
# ---------------------------------------------------------------------
MLPX2_TOOLS  := $(CAMR_HOME)/Source/EOS/MLPx2/tools
MLPX2_DATA   := $(CAMR_HOME)/Source/EOS/MLPx2/mlpx2_table_data.cpp
MLPX2_PARAMS := $(CAMR_HOME)/Source/EOS/MLPx2/mlpx2_table_params.H

.PHONY: tables clean-tables
tables:
	@echo "Generating MLPx2 PR-EOS tables (auto + liquid + vapor)..."
	python3 $(MLPX2_TOOLS)/build_table.py

clean-tables:
	@$(RM) $(MLPX2_DATA) $(MLPX2_PARAMS) $(MLPX2_TOOLS)/gen_table $(MLPX2_TOOLS)/_grid_*.tmp
	@echo "removed generated MLPx2 tables (rerun 'make tables' to regenerate)"

ifeq ($(Eos_Model),$(filter $(Eos_Model),GammaLaw))
   DEFINES += -DUSE_GAMMALAW_EOS
   EOS_DIR = GammaLaw
endif
ifeq ($(Eos_Model),$(filter $(Eos_Model),TableEOS))
   DEFINES += -DUSE_TABLE_EOS
   EOS_DIR = TableEOS
endif
ifeq ($(Eos_Model),$(filter $(Eos_Model),RealFluidCO2))
   DEFINES += -DUSE_REALFLUID_CO2_EOS
   EOS_DIR = RealFluidCO2
endif
ifeq ($(Eos_Model),$(filter $(Eos_Model),MLPx2))
   DEFINES += -DUSE_MLPX2_EOS
   EOS_DIR = MLPx2
   # NOTE: do NOT add RealFluidCO2 to the include path — it would shadow
   # MLPx2/EOS.H (both are named EOS.H, and an earlier -I wins), silently
   # compiling the PR backend.  MLPx2 carries its own copies of the PR
   # fallback headers (hem_pr_state.H, hem_saturation_amrex.H).
   #
   # The generated tables (mlpx2_table_data.cpp / _params.H) are git-ignored.
   # FAIL EARLY with a clear message if they are absent — EXCEPT when the goal
   # is to generate/clean them (else `make tables` would block itself).
   ifeq (,$(filter tables clean-tables,$(MAKECMDGOALS)))
     ifeq (,$(wildcard $(MLPX2_DATA)))
       $(error MLPx2 EOS tables not generated -- run: make tables  (needs g++ + python3/numpy/scipy))
     endif
   endif
endif
Bdirs := $(CAMR_HOME)/Source
Bdirs += $(CAMR_HOME)/Source/Hydro
Bdirs += $(CAMR_HOME)/Source/Hydro/Godunov
Bdirs += $(CAMR_HOME)/Source/Hydro/MOL
ifeq ($(USE_PS_HYDRO), TRUE)
  Bdirs += $(CAMR_HOME)/Source/Hydro/PelantiShyue
endif
Bdirs += $(CAMR_HOME)/Source/Utils
Bdirs += $(CAMR_HOME)/Source/EOS/$(EOS_DIR) $(CAMR_HOME)/Source/EOS
Bdirs += $(CAMR_HOME)/Source/Params/param_includes

Pdirs := Base Amr Boundary AmrCore
ifeq ($(USE_EB), TRUE)
  Pdirs += EB
  Bdirs += $(CAMR_HOME)/Source/EB
endif

Bpack += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)
Blocs += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir))

Bpack += $(foreach dir, $(Bdirs), $(dir)/Make.package)
Blocs += $(foreach dir, $(Bdirs), $(dir))

$(info $${Blocs} is [${Blocs}])

include $(Bpack)

INCLUDE_LOCATIONS += $(Blocs)
VPATH_LOCATIONS   += $(Blocs)

CEXE_sources += AMReX_buildInfo.cpp
CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS += $(AMREX_HOME)/Tools/C_scripts

AMReX_buildInfo.cpp:
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --FCOMP "$(FCOMP)" --FCOMP_VERSION "$(FCOMP_VERSION)" \
          --MODULES "$(MNAMES)" \
          --GIT "$(TOP) $(AMREX_HOME)"

include $(AMREX_HOME)/Tools/GNUMake/Make.rules

clean::
	$(SILENT) $(RM) AMReX_buildInfo.cpp

#-----------------------------------------------------------------------------
# for debugging.  To see the value of a Makefile variable,
# e.g. Fmlocs, simply do "make print-Fmlocs".  This will
# print out the value.
#print-%: ; @echo $* is $($*) ; $(SILENT) $(RM) AMReX_buildInfo.cpp
