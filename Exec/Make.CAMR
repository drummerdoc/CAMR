TOP ?= $(CAMR_HOME)

EBASE = CAMR

#Turn off all fortran in amrex
BL_NO_FORT = TRUE

include $(AMREX_HOME)/Tools/GNUMake/Make.defs

ifeq ($(USE_EB), TRUE)
  DEFINES += -DAMREX_USE_EB
  USERSuffix += .EB
endif

ifeq ($(USE_MOVING_EB), TRUE)
  DEFINES += -DCAMR_USE_MOVING_EB
endif

# Pelanti-Shyue six-equation hydro module.  Off by default; per-case
# opt-in via USE_PS_HYDRO := TRUE in the Exec GNUmakefile.  When set, the
# conservative state grows by 5 components (α₁, α_k ρ_k, α_k ρ_k E_k) and
# the PelantiShyue Hydro module is compiled in (its Bdirs line is with the
# other Bdirs additions below; here only DEFINES and the suffix are set, so
# build-output directories are separable).
# See Source/Hydro/PelantiShyue/README.md.
ifeq ($(USE_PS_HYDRO), TRUE)
  DEFINES += -DUSE_PS_HYDRO
  USERSuffix += .PS
  # The PS module requires the extended EOS contract (T_triple, per-phase
  # branch-locked entry points, saturation curve...).  GammaLaw does not
  # provide it; fail early with a clear message instead of a wall of
  # missing-function errors.
  ifeq ($(Eos_Model),$(filter $(Eos_Model),GammaLaw))
    $(error USE_PS_HYDRO=TRUE requires an EOS backend with the extended PS contract (PR, PRTab, GERG, GERGTab); Eos_Model=$(Eos_Model) does not provide it)
  endif
  # hydro_umdrv_eb has no PS branch: cut boxes would run Godunov on the
  # six-equation state.
  ifeq ($(USE_EB), TRUE)
    $(error USE_PS_HYDRO=TRUE does not support USE_EB=TRUE)
  endif
endif

# ---------------------------------------------------------------------
#  Put the EOS backend into the executable name and the object directory
#  (CAMR2d.llvm.TPROF.MPI.PS.PR.ex, ...PS.GERGTab.ex).  Without it a binary
#  built for one backend can be run for another unnoticed, and, because
#  AMReX derives the object directory from the same suffix, switching
#  Eos_Model without `make realclean` silently reuses objects compiled
#  with another backend's -DUSE_*_EOS defines (make compares timestamps).
#  Use `:=` concatenation, not `+=`: on a non-empty variable `+=` inserts a
#  space (USERSuffix = ".PS .PR") and splits every derived path.  This must
#  come before `all: $(executable)` (prerequisites are expanded when the
#  rule is read); Eos_Model is set by the Exec GNUmakefile before this.
# ---------------------------------------------------------------------
ifneq ($(Eos_Model),)
  USERSuffix := $(USERSuffix).$(Eos_Model)
endif

all: $(executable)
ifneq ($(KEEP_BUILDINFO_CPP),TRUE)
	$(SILENT) $(RM) AMReX_buildInfo.cpp
endif
	@echo SUCCESS

# ---------------------------------------------------------------------
#  PRTab table EOS generation.  The bicubic PR table
#  (prtab_table_data.cpp, ~6 MB) is generated, not committed, and
#  git-ignored; a PRTab build without it fails early at the $(error) guard
#  below.  Generate all three branches (auto + liquid + vapor) with
#  `make tables` (needs a host g++ and python3 with numpy + scipy); remove
#  them with `make clean-tables`.  Neither is invoked by `make clean` /
#  `make realclean`.
# ---------------------------------------------------------------------
PRTAB_TOOLS  := $(CAMR_HOME)/Source/EOS/PRTab/tools
PRTAB_DATA   := $(CAMR_HOME)/Source/EOS/PRTab/prtab_table_data.cpp
PRTAB_PARAMS := $(CAMR_HOME)/Source/EOS/PRTab/prtab_table_params.H

.PHONY: tables clean-tables
tables:
	@echo "Generating PRTab PR-EOS tables (auto + liquid + vapor)..."
	python3 $(PRTAB_TOOLS)/build_table.py

clean-tables:
	@$(RM) $(PRTAB_DATA) $(PRTAB_PARAMS) $(PRTAB_TOOLS)/gen_table $(PRTAB_TOOLS)/_grid_*.tmp
	@echo "removed generated PRTab tables (rerun 'make tables' to regenerate)"

ifeq ($(Eos_Model),$(filter $(Eos_Model),GammaLaw))
   DEFINES += -DUSE_GAMMALAW_EOS
   EOS_DIR = GammaLaw
endif
ifeq ($(Eos_Model),$(filter $(Eos_Model),PR))
   DEFINES += -DUSE_PR_EOS
   EOS_DIR = PR
endif
ifeq ($(Eos_Model),$(filter $(Eos_Model),PRTab))
   DEFINES += -DUSE_PRTAB_EOS
   EOS_DIR = PRTab
   # Do not add PR to the include path: it would shadow PRTab/EOS.H (both
   # are named EOS.H, and an earlier -I wins), silently compiling the PR
   # backend.  PRTab reaches the PR state machinery through its own
   # forwarding headers (hem_pr_state.H, hem_saturation_amrex.H).
   # The generated tables (prtab_table_data.cpp / _params.H) are
   # git-ignored: fail early if they are absent, except when the goal is
   # to generate or clean them (else `make tables` would block itself).
   ifeq (,$(filter tables clean-tables,$(MAKECMDGOALS)))
     ifeq (,$(wildcard $(PRTAB_DATA)))
       $(error PRTab EOS tables not generated -- run: make tables  (needs g++ + python3/numpy/scipy))
     endif
   endif
endif
GERGTAB_TOOLS := $(CAMR_HOME)/Source/EOS/GERGTab/tools
GERGTAB_DATA  := $(CAMR_HOME)/Source/EOS/GERGTab/gergtab_table_data.cpp
.PHONY: gergtab-tables clean-gergtab-tables
gergtab-tables:
	@echo "Generating GERGTab T(rho,e) tables (auto + liquid + vapor)..."
	cd $(GERGTAB_TOOLS) && g++ -O2 -std=c++17 gen_gergtab.cpp -o gen_gergtab && ./gen_gergtab 256
clean-gergtab-tables:
	@$(RM) $(GERGTAB_DATA) $(CAMR_HOME)/Source/EOS/GERGTab/gergtab_table_params.H $(GERGTAB_TOOLS)/gen_gergtab
	@echo "removed generated GERGTab tables (rerun 'make gergtab-tables')"

ifeq ($(Eos_Model),$(filter $(Eos_Model),GERGTab))
   DEFINES += -DUSE_GERGTAB_EOS
   EOS_DIR = GERGTab
   # Physics lives in Source/EOS/GERG (included by path); this dir owns the
   # bicubic module + generated tables.  Fail early if tables are absent.
   ifeq (,$(filter gergtab-tables clean-gergtab-tables,$(MAKECMDGOALS)))
     ifeq (,$(wildcard $(GERGTAB_DATA)))
       $(error GERGTab tables not generated -- run: make gergtab-tables  (needs host g++))
     endif
   endif
endif
ifeq ($(Eos_Model),$(filter $(Eos_Model),GERG))
   DEFINES += -DUSE_GERG_EOS
   EOS_DIR = GERG
   # GERG-2008 pure-CO2 backend: guarded evaluator plus generated
   # saturation/edge splines, all committed headers, so there is no
   # table-generation step.  hem_pr_state.H is included via -I Source/
   # ("EOS/PR/...") for the hem::Phase3 interface type only; no PR
   # function is called (no cross-EOS fallback).
endif

Bdirs := $(CAMR_HOME)/Source
Bdirs += $(CAMR_HOME)/Source/Hydro
Bdirs += $(CAMR_HOME)/Source/Hydro/Godunov
Bdirs += $(CAMR_HOME)/Source/Hydro/MOL
ifeq ($(USE_PS_HYDRO), TRUE)
  Bdirs += $(CAMR_HOME)/Source/Hydro/PelantiShyue
endif
Bdirs += $(CAMR_HOME)/Source/Utils
Bdirs += $(CAMR_HOME)/Source/EOS/$(EOS_DIR) $(CAMR_HOME)/Source/EOS
Bdirs += $(CAMR_HOME)/Source/Params/param_includes

Pdirs := Base Amr Boundary AmrCore
ifeq ($(USE_EB), TRUE)
  Pdirs += EB
  Bdirs += $(CAMR_HOME)/Source/EB
endif

Bpack += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)
Blocs += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir))

Bpack += $(foreach dir, $(Bdirs), $(dir)/Make.package)
Blocs += $(foreach dir, $(Bdirs), $(dir))

$(info $${Blocs} is [${Blocs}])

include $(Bpack)

INCLUDE_LOCATIONS += $(Blocs)
VPATH_LOCATIONS   += $(Blocs)

CEXE_sources += AMReX_buildInfo.cpp
CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS += $(AMREX_HOME)/Tools/C_scripts

AMReX_buildInfo.cpp:
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --FCOMP "$(FCOMP)" --FCOMP_VERSION "$(FCOMP_VERSION)" \
          --MODULES "$(MNAMES)" \
          --GIT "$(TOP) $(AMREX_HOME)"

include $(AMREX_HOME)/Tools/GNUMake/Make.rules

clean::
	$(SILENT) $(RM) AMReX_buildInfo.cpp

#-----------------------------------------------------------------------------
# for debugging.  To see the value of a Makefile variable,
# e.g. Fmlocs, simply do "make print-Fmlocs".  This will
# print out the value.
#print-%: ; @echo $* is $($*) ; $(SILENT) $(RM) AMReX_buildInfo.cpp
