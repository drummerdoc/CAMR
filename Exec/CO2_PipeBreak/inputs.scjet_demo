# =====================================================================
#  CO2_PipeBreak — SHOWCASE: supercritical under-expanded CO2 jet,
#  full plane, 3-level AMR.  Robust demo (single-phase, T>T_crit so no
#  dome/flash delicacy; the 8:1 vent gives a barrel-shock / Mach-disk).
#  Validated clean & symmetric at single level (rung 3) and under AMR
#  (rung 2); this file packages it as the full-plane AMR money-shot.
# =====================================================================
amrex.fpe_trap_invalid = 0
max_step  = 20000
stop_time = 2.5e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 2.0  1.0
amr.n_cell           = 256  128            # base; 3 levels -> 1024x512 finest

CAMR.lo_bc = Inflow Inflow
CAMR.hi_bc = Inflow Inflow

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0

CAMR.ps_do_relax  = 1
CAMR.ps_mt_tau    = 1.0e-6
CAMR.ps_mt_gref   = 5.0e4
CAMR.ps_flash_tau = 0.0          # flash OFF (single-phase supercritical)
CAMR.ps_pres_floor = 1.0e5
CAMR.ps_temp_floor = 216.6
# CAMR.eos_warmstart = 1         # optional throughput (safe; ~1e-11 asym)

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist
amr.loadbalance_with_workestimates = 0

amr.max_level       = 2
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.9
amr.refinement_indicators = ldtag
amr.ldtag.field_name = logden
amr.ldtag.adjacent_difference_greater = 0.15   # ~1.4x density jump: jet head/shock
amr.ldtag.max_level = 2

DistributionMapping.strategy = ROUNDROBIN
amr.checkpoint_files_output = 1
amr.check_file              = chk_sd
amr.check_int               = 200
amr.plot_files_output = 1
amr.plot_file         = plt_sd
amr.plot_int          = 25
amr.derive_plot_vars  = x_velocity y_velocity pressure

# --- Problem state: deep-supercritical, 8:1 under-expanded vent -------
prob.p0       = 1.0e6     # Pa   ambient (10 bar)
prob.T0       = 600.0     # K    ambient (>> T_crit=304 K -> supercritical)
prob.u0       = 0.0
prob.p_amb    = 1.0e6
prob.p_res    = 8.0e6     # Pa   reservoir (80 bar; 8:1 under-expanded)
prob.T_res    = 600.0
prob.res_alpha1 = 1.0     # single-phase (supercritical) reservoir
prob.amb_vapor  = 0       # supercritical: phase-1 branch is fine
prob.sym_ylo    = 0       # FULL PLANE
prob.gap_yc   = 0.5
prob.gap_half = 0.05
prob.gap_taper = 0.02
prob.ramp_time = 3.0e-4
