# =====================================================================
#  CO2_PipeBreak — Track-A controlled flash-ablation BASE case.
#  Full plane, single level, subcritical moderate vent, MT + floors on.
#  Change EXACTLY ONE thing per run (flash tau, inlet width, T_res, h-mode,
#  resolution) and score with the same health metrics.  This file is the
#  fixed control; overrides are passed on the command line.
# =====================================================================
amrex.fpe_trap_invalid = 0
max_step  = 20000
stop_time = 2.0e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 1.0  0.5
amr.n_cell           = 128  64          # dx=dy=7.8 mm (matches the original)

CAMR.lo_bc = Inflow Inflow
CAMR.hi_bc = Inflow Inflow

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0

CAMR.ps_do_relax  = 1
CAMR.ps_mt_tau    = 1.0e-6
CAMR.ps_mt_gref   = 5.0e4
CAMR.ps_flash_tau = 0.0          # CONTROL default OFF; override on cmd line
CAMR.ps_pres_floor = 1.0e5
CAMR.ps_temp_floor = 216.6

CAMR.v = 1
amr.v = 0
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.9
amr.refinement_indicators = ldtag
amr.ldtag.field_name = logden
amr.ldtag.adjacent_difference_greater = 0.15
amr.ldtag.max_level = 2

DistributionMapping.strategy = ROUNDROBIN
amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = pa_
amr.plot_int          = 40
amr.derive_plot_vars  = x_velocity y_velocity pressure

# --- Base state: subcritical liquid -> gas, moderate 3:1, gap centered -----
prob.p0       = 2.0e6     # 20 bar gas ambient (280 K; Psat~41 bar)
prob.T0       = 280.0
prob.u0       = 0.0
prob.p_amb    = 2.0e6
prob.p_res    = 6.0e6     # 60 bar compressed liquid
prob.T_res    = 280.0
prob.res_alpha1 = 1.0
prob.amb_vapor = 1        # gas ambient on the vapor branch (phase 2)
prob.sym_ylo  = 0         # FULL PLANE
prob.gap_yc   = 0.25      # gap centered (full plane)
prob.gap_half = 0.05
prob.gap_taper = 0.02
prob.ramp_time = 2.5e-4
