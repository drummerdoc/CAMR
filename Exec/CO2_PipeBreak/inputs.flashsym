# =====================================================================
#  CO2_PipeBreak — RUNG 5: flash ON, HALF-DOMAIN centerline symmetry.
#
#  Upper half y in [0.5,1.0]; y-lo is a slip-wall MIRROR (prob.sym_ylo=1) at
#  the centerline, so the symmetric jet is solved on half the domain and the
#  antisymmetric (flapping) flash-lip mode is excluded by construction.
#
#  Physics: moderate flashing blowdown — single-phase compressed-liquid CO2
#  reservoir (T=280 K, 60 bar) vented into gas ambient (20 bar).  The
#  expansion crosses the saturation dome, so the flash nucleation source
#  (ps_flash_tau=1e-5) fires in the metastable jet — the physics held out of
#  rungs 1-4.  Goal: verify flash is clean/stable/bounded once the flapping
#  mode is removed.
# =====================================================================

amrex.fpe_trap_invalid = 0
max_step  = 20000
stop_time = 4.0e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.5
geometry.prob_hi     = 2.0  1.0
amr.n_cell           = 256  64

CAMR.lo_bc = Inflow Inflow            # y-lo -> bcnormal sym mirror (sym_ylo=1)
CAMR.hi_bc = Inflow Inflow

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0

CAMR.ps_do_relax  = 1
CAMR.ps_mt_tau    = 1.0e-6
CAMR.ps_mt_gref   = 5.0e4
CAMR.ps_flash_tau = 1.0e-5      # FLASH ON (nucleation) — the held-out physics
CAMR.ps_pres_floor = 1.0e5
CAMR.ps_temp_floor = 216.6

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist
amr.loadbalance_with_workestimates = 0

amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.9
amr.refinement_indicators = ldtag
amr.ldtag.field_name = logden
amr.ldtag.adjacent_difference_greater = 0.15
amr.ldtag.max_level = 2

DistributionMapping.strategy = ROUNDROBIN
amr.checkpoint_files_output = 0
amr.check_file              = chk_fs
amr.check_int               = -1
amr.plot_files_output = 1
amr.plot_file         = plt_fs
amr.plot_int          = 25
amr.derive_plot_vars  = x_velocity y_velocity pressure

# --- Problem state: compressed-liquid reservoir -> gas ambient --------
prob.p0       = 2.0e6     # Pa   ambient (20 bar; gas at 280 K, Psat~41 bar)
prob.T0       = 280.0     # K    ambient
prob.u0       = 0.0
prob.p_amb    = 2.0e6     # Pa   outflow far-field target
prob.p_res    = 6.0e6     # Pa   reservoir (60 bar > Psat -> compressed liquid)
prob.T_res    = 280.0     # K    reservoir
prob.res_alpha1 = 1.0     #      single-phase (liquid, phase-1) reservoir
prob.amb_vapor = 1        #      gas ambient on the VAPOR branch (phase 2)
prob.sym_ylo  = 1         #      y-lo = centerline symmetry mirror
prob.gap_yc   = 0.5       # m    gap centre at the y-lo symmetry plane
prob.gap_half = 0.05
prob.gap_taper = 0.02
prob.ramp_time = 5.0e-4
