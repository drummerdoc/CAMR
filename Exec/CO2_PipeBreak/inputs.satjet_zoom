# =====================================================================
#  CO2_PipeBreak — ZOOM: resolve the near-orifice shear-layer / jet-column
#  instability.  Small, short-time domain focused on the orifice and the
#  first jet-width downstream, at high UNIFORM resolution, with the
#  numerical dissipation knobs OFF, to test whether the transverse
#  instability resolves into smooth multi-cell structure (physical) or
#  stays point-to-point (numerical).
#
#  Key idea: the shear-layer thickness is set by the injection taper
#  (gap_taper = 0.02 m).  At this resolution that taper is ~27 cells thick,
#  so the Kelvin-Helmholtz roll-up should be resolved with many cells per
#  wavelength IF the instability is physical.  Dissipation is off so we see
#  the raw scheme behaviour.
# =====================================================================
amrex.fpe_trap_invalid = 0
max_step  = 800                        # dt~5e-7 at 320x400, so ~600 steps to
stop_time = 3.0e-4                     #   reach t=3e-4 where the roll-up develops

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0   0.35      # zoom box: orifice + first jet-width
geometry.prob_hi     = 0.24  0.65      # 0.24 x 0.30 m, gap centred at y=0.5
amr.n_cell           = 320  400        # dx=dy=7.5e-4 m (square).  gap_half=67
                                       # cells, gap_taper=27 cells, jet=128 cells

CAMR.lo_bc = Inflow Inflow             # x-lo = orifice; y-lo = outflow
CAMR.hi_bc = Inflow Inflow             # x-hi, y-hi = outflow (ambient)

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0
CAMR.ps_alpha_vanish = 1.0e-8
CAMR.ps_wp_transverse = 0    # OFF: raw scheme, no transverse coupling knob
CAMR.ps_shear_diss    = 0.0  # OFF: no dissipation — see the raw instability

CAMR.ps_do_relax  = 1
CAMR.ps_relax_mode = 1        # P+T equilibrium (HEM): thermally couples phases, prevents per-phase energy runaway (#64/#72)
CAMR.ps_mt_tau    = 1.0e-6
CAMR.ps_mt_gref   = 5.0e4
CAMR.ps_flash_tau = 0.0
CAMR.ps_pres_floor = 1.0e5
CAMR.ps_temp_floor = 216.6

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist
amr.loadbalance_with_workestimates = 0

amr.max_level       = 0                # UNIFORM (no AMR C-F artifacts)

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = zoom_
amr.plot_int          = 10             # plotfile every 10 steps -> ~11 snapshots
amr.plot_per          = -1
amr.derive_plot_vars  = x_velocity y_velocity pressure

# --- Problem state: saturated two-phase reservoir -> vapor ambient ----
prob.p0       = 1.0e6
prob.T0       = 280.0
prob.u0       = 0.0
prob.p_amb    = 1.0e6
prob.p_res    = 4.0e6
prob.T_res    = 280.0
prob.res_alpha1 = 0.05
prob.res_dome_taper = 1
prob.res_u      = 0.0
prob.amb_vapor  = 1
prob.sym_ylo    = 0            # full plane (both shear layers, sinuous+varicose)
prob.gap_yc   = 0.5
prob.gap_half = 0.05
prob.gap_taper = 0.02          # sets the shear-layer seed thickness (~27 cells)
prob.gap_bell  = 0.0
prob.ramp_time = 3.0e-4
