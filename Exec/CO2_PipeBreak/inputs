# =====================================================================
#  CO2_PipeBreak — Phase 0: 2-D flashing CO2 pipe-break jet (CPU, PR EOS)
#
#  x-lo is the rupture plane: dense-CO2 reservoir over the break gap,
#  slip wall elsewhere (both realised in prob.H bcnormal).  x-hi, y-lo,
#  y-hi are non-reflecting outflow.  Legacy bcnormal path (ps_bc_use_nscbc
#  = 0) so the rupture-plane logic is what fills the boundary.
# =====================================================================

amrex.fpe_trap_invalid = 0

max_step  = 20000
stop_time = 2.0e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 2.0  1.0
amr.n_cell           = 256  128

# All four faces dispatch to prob.H bcnormal:
#   x-lo -> rupture plane (reservoir gap / slip wall)
#   x-hi, y-lo, y-hi -> linear-acoustic non-reflecting outflow
CAMR.lo_bc = Inflow Inflow
CAMR.hi_bc = Inflow Inflow

# --- Physics + numerics ---------------------------------------------
CAMR.cfl = 0.25
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro   = 1
# wp (Berger-LeVeque wave propagation) is the production flux: cleaner,
# limited (non-oscillatory) contacts vs HLLC.  It DOES drive the reservoir
# inlet, but only with piecewise-constant reconstruction — ps_recon MUST be 0
# (ps_recon=1 = piecewise-linear MUSCL/PLM reconstructs interior-only at the
# boundary and ignores the Dirichlet reservoir ghost, so the jet never fires;
# task #43).  For a quick diffusive-but-robust fallback, set ps_flux=hllc
# ps_recon=0.
CAMR.ps_flux    = wp
CAMR.ps_wp_order = 2            # 2nd order via BL-2 limited correction fluxes
CAMR.ps_recon   = 0            # piecewise-constant (REQUIRED for wp inlet injection)
CAMR.ps_bc_use_nscbc = 0        # legacy bcnormal path (rupture-plane BC)

# Relaxation + stabilized finite-rate mass transfer (option 2 default).
CAMR.ps_do_relax = 1
CAMR.ps_mt_tau   = 1.0e-6
CAMR.ps_mt_gref  = 5.0e4
# Positivity floor (task #50): branch-consistently raise per-phase energy so
# P_k >= this, post-hydro.  Prevents the strong-vent (18:1) gap-edge shear
# from cratering to vacuum (dt collapse) — holds Pmin at the floor and tames
# the whole oscillation cascade.  1 bar keeps dt healthy for a stable demo;
# lower (0.1-0.5 bar) preserves more of the physical jet-edge expansion but
# runs slower.  Default 0 = off (other Execs / the 1-D suite are unaffected).
CAMR.ps_pres_floor = 1.0e5
# Temperature floor (task #50): raise per-phase energy so T_k >= this.
# Strong-vent expansion cools CO2 below its triple point (216.6 K) where the
# PR EOS is invalid and T oscillates; floor at the triple point to keep the
# EOS valid.  0 = off.  (Below the triple point real CO2 would form dry ice,
# which this EOS cannot model.)
CAMR.ps_temp_floor = 216.6
# Nucleation source (flash).  Under the sharp wp scheme the flash must be
# seeded physically (unlike HLLC, whose numerical mixing at the contact
# spuriously seeded two-phase cells).  Subcritical-gated (216.6..304.13 K).
#
# CLEAN/SYMMETRIC BASELINE (task #56): flash is DISABLED (tau=0) here.  The
# flash-created two-phase lip under the 18:1 vent is a physical amplifier that
# grows any perturbation (down to round-off) into an O(1) asymmetry by ~step 70
# even with the continuous flash machinery (smooth activation + fractional
# limiter cut the SEED ~100-1000x but cannot beat a few-step e-folding
# amplifier).  With flash off the run is round-off symmetric and stable
# (MT + mechanical relaxation still give the two-phase vent physics).
# Re-hardening ladder: re-enable flash (set tau=1.0e-5) only behind a
# centerline symmetry BC / with lip regularization, validating symmetry at
# each rung.  See docs/design/co2_pipebreak_demo_roadmap.md.
CAMR.ps_flash_tau = 0.0        # 0 = flash OFF (clean baseline); 1.0e-5 = on

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist
amr.loadbalance_with_workestimates = 0

# --- AMR: refine the flash front / shocks near the break ------------
amr.max_level       = 2
# ref_ratio: 2 per level.  In 2-D a single factor-of-4 level (ref_ratio=4,
# max_level=1) is often more efficient than two factor-of-2 levels for the
# same effective resolution — runs (advances + regrids, no crash) but the
# rr=4 PS reflux/regrid still needs a full-length validation run.
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.9

# Refinement criteria — chosen by what each feature IS:
#  (a) ldtag: log10(density) jump — the JET HEAD is a CONTACT (dense injected
#      CO2 | ambient), across which PRESSURE is continuous, so a pressure tag
#      cannot see it; density jumps there (and at shocks), so logden is the
#      comprehensive "follow the growing jet head" criterion.
#  (b) atag: ps_alpha1 (=alpha_1) < 0.95 — the flashing two-phase plume.
# Both are DERIVES: tagging a raw STATE var (density, alpha_1) segfaults the
# tagger; and value_less (not adjacent_difference) is used for alpha_1 (the
# adjacent_difference tagger on the derive hit an AMReX heap bug).
# (A pressure-jump tag would only add pure-shock/Mach-disk sharpening that
#  logden largely already covers — left off to save cells; re-add if needed.)
amr.refinement_indicators = ldtag atag
amr.ldtag.field_name = logden
amr.ldtag.adjacent_difference_greater = 0.15   # ~1.4x density jump (log10)
amr.ldtag.max_level = 2
amr.atag.field_name = ps_alpha1
amr.atag.value_less = 0.95
amr.atag.max_level = 2

DistributionMapping.strategy = ROUNDROBIN

amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = -1

amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 10
amr.derive_plot_vars  = x_velocity y_velocity pressure

# --- Problem state ---------------------------------------------------
prob.p0       = 5.0e5     # Pa   ambient (5 bar)
prob.T0       = 260.0     # K    ambient
prob.u0       = 0.0
prob.p_amb    = 5.0e5     # Pa   outflow far-field target
prob.p_res    = 9.0e6     # Pa   reservoir (90 bar dense CO2; 18:1 vent)
prob.T_res    = 290.0     # K    reservoir
prob.gap_yc   = 0.5       # m    break-gap centre
prob.gap_half = 0.05      # m    break-gap half-width (gap = 0.1 m)
prob.gap_taper = 0.02     # m    lip taper: smoothstep-blend the reservoir
                          #      ghost into the slip-wall ghost over this
                          #      width outside the gap edge, so the inlet is
                          #      a soft orifice (no infinite-shear lip that
                          #      craters to vacuum). 0 = hard top-hat (task #49)
prob.ramp_time = 5.0e-4   # s    soft-start: ramp p0->p_res over this time
                          #      (0 = instantaneous full reservoir; task #48)
