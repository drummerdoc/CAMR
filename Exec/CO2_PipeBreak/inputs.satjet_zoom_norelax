# =====================================================================
#  CO2_PipeBreak — ZOOM ISOLATION A:  RELAXATION OFF.
#  Identical to inputs.satjet_zoom (mu=2 baked in) EXCEPT ps_do_relax=0:
#  no pressure relaxation, no mass transfer, no flash — pure PS hydro on
#  the dense two-phase inlet slug.  Diagnostic: if the inlet-slug 2-delta
#  pressure ring (P odd-even ~63% at nearly constant density) DISAPPEARS,
#  the relaxation machinery is the pump.  If it PERSISTS, the bare wp
#  two-phase contact flux is the seed.
#  Short run: reach step 400 (t~2e-4), where the slug speckle is obvious.
# =====================================================================
amrex.fpe_trap_invalid = 0
max_step  = 400
stop_time = 2.0e-4

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0   0.35
geometry.prob_hi     = 0.24  0.65
amr.n_cell           = 320  400

CAMR.lo_bc = Inflow Inflow
CAMR.hi_bc = Inflow Inflow

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0
CAMR.ps_alpha_vanish = 1.0e-8
CAMR.ps_wp_transverse = 0
CAMR.ps_shear_diss    = 0.0
CAMR.ps_mu            = 2.0     # same viscosity as zoom2 baseline

CAMR.ps_do_relax  = 0          # <<< ISOLATION A: ALL relaxation OFF
CAMR.ps_mt_tau    = 1.0e-6
CAMR.ps_mt_gref   = 5.0e4
CAMR.ps_flash_tau = 0.0
CAMR.ps_pres_floor = 1.0e5
CAMR.ps_temp_floor = 216.6

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist
amr.loadbalance_with_workestimates = 0

amr.max_level       = 0

amr.checkpoint_files_output = 0
amr.plot_files_output = 1
amr.plot_file         = zoomNR_
amr.plot_int          = 100
amr.plot_per          = -1
amr.derive_plot_vars  = x_velocity y_velocity pressure

