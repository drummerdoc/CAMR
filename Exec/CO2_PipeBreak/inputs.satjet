# =====================================================================
#  CO2_PipeBreak — RUNG 4: saturated two-phase CO2 blowdown (task #56).
#
#  Reservoir = SATURATED two-phase mixture at T_res=280 K (P=Psat~41 bar),
#  liquid volume fraction prob.res_alpha1=0.5, vented into single-phase gas
#  ambient at 20 bar.  Genuine two-phase cells enter the domain from the
#  inlet, so MT + mechanical relaxation are exercised on real coexistence
#  WITHOUT flash nucleation (flash stays OFF).  This isolates whether the
#  two-phase relaxation physics is clean/symmetric before re-adding the flash
#  amplifier (rung 5).
# =====================================================================

amrex.fpe_trap_invalid = 0
max_step  = 20000
stop_time = 4.0e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 2.0  1.0
amr.n_cell           = 256  128

CAMR.lo_bc = Inflow Inflow
CAMR.hi_bc = Inflow Inflow

CAMR.cfl = 0.3
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro    = 1
CAMR.ps_flux     = wp
CAMR.ps_wp_order = 2
CAMR.ps_recon    = 0
CAMR.ps_bc_use_nscbc = 0
CAMR.ps_alpha_vanish = 1.0e-8

CAMR.ps_do_relax  = 1
CAMR.ps_mt_tau    = 1.0e-6      # mass transfer ON (acts on real two-phase cells)
CAMR.ps_mt_gref   = 5.0e4
CAMR.ps_flash_tau = 0.0         # flash OFF (reservoir is already two-phase)
CAMR.ps_pres_floor = 1.0e5
CAMR.ps_temp_floor = 216.6

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist
amr.loadbalance_with_workestimates = 0

amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.9
amr.refinement_indicators = ldtag
amr.ldtag.field_name = logden
amr.ldtag.adjacent_difference_greater = 0.15
amr.ldtag.max_level = 2

DistributionMapping.strategy = ROUNDROBIN
amr.checkpoint_files_output = 0
amr.check_file              = chk_sat
amr.check_int               = -1
amr.plot_files_output = 1
amr.plot_file         = plt_sat
amr.plot_int          = 25
amr.derive_plot_vars  = x_velocity y_velocity pressure

# --- Problem state: saturated two-phase reservoir, gas ambient --------
prob.p0       = 2.0e6     # Pa   ambient (20 bar; gas at 280 K since Psat~41 bar)
prob.T0       = 280.0     # K    ambient
prob.u0       = 0.0
prob.p_amb    = 2.0e6     # Pa   outflow far-field target
prob.p_res    = 4.0e6     # Pa   (unused for two-phase reservoir; P=Psat(T_res))
prob.T_res    = 280.0     # K    reservoir temperature (sets Psat + sat states)
prob.res_alpha1 = 0.5     #      liquid volume fraction (0<..<1 = two-phase blowdown)
prob.gap_yc   = 0.5
prob.gap_half = 0.05
prob.gap_taper = 0.02
prob.ramp_time = 5.0e-4
