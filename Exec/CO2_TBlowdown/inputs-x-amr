# =====================================================================
#  T-Blowdown along x with one level of AMR
#
#  The inputs-x physics (closed 1 m pipe of supercritical CO2 at 100 bar,
#  320 K, NSCBC vent at x = 1 to 1 bar) on a 128 x 16 base grid with
#  max_level = 1 and a pressure-jump refinement tag, so the wave region
#  runs at effective N = 256.  Standalone deck (does not include
#  inputs.base); max_step = 300 governs the run length.
#
#  Purpose: exercise the AMR pipeline (regrid interpolation, reflux)
#  with the six-equation state.  Reflux is a no-op for UALPHA1 because
#  its flux is zero in the wave-propagation form, so the test mostly
#  exercises interpolation of the extended slots (UALPHA1, UM1RHO1,
#  UM2RHO2, UE1, UE2) on regrid.
#
#  What to check after the run:
#    * alpha_1 stays in [alpha_floor, 1 - alpha_floor] on all levels
#    * alpha_1 rho_1 + alpha_2 rho_2 = rho holds after regrid
#    * E_1 + E_2 = rho E holds after regrid
#    * N = 128 uniform vs this deck vs N = 256 uniform: the AMR run
#      sits between the two.
# =====================================================================

amrex.fpe_trap_invalid = 0

max_step  = 300
stop_time = 1.65e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     =   0.0    0.0    0.0
geometry.prob_hi     =   1.0    0.125  0.125

# Base level N = 128; the fine level gives effective N = 256 in the
# wave region.
amr.n_cell           =   128   16   16

CAMR.lo_bc       =  SlipWall   SlipWall   SlipWall
CAMR.hi_bc       =  Inflow     SlipWall   SlipWall

CAMR.cfl = 0.25
CAMR.fixed_dt = 0

CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro = 1
#  The flux is the compiled default (wp), written out so the deck
#  records the scheme it runs; ps_wp_order stays at its default (1).
CAMR.ps_flux  = wp
CAMR.ps_bc_use_nscbc = 1
CAMR.ps_bc_nscbc_sigma = 0.25

CAMR.v = 1
amr.v = 1

CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

amr.loadbalance_with_workestimates = 0

# --- AMR structure -------------------------------------------------
# Two levels: base (N = 128) plus one 2x refinement.
amr.max_level       = 1
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 4 4 4 4     # regrid every 4 base-level steps
amr.blocking_factor = 8
amr.max_grid_size   = 32
amr.n_error_buf     = 2 2 2 2
amr.grid_eff        = 0.7

# --- Refinement tagger ---------------------------------------------
# Pressure-jump tag: refine cells where |P(i+1) − P(i)| exceeds
# 5 × 10^4 Pa = 0.05 MPa.  Measured on the N=128 baseline slice,
# the T-Blowdown rarefaction has |ΔP| ≈ 0.10-0.12 MPa/cell in its
# middle and up to ~1 MPa/cell at the compound-wave transition.
# A threshold of 0.05 MPa tags the entire wave region (a strip
# ~30 cells wide) plus a few cells in the outflow.  The initial
# uniform 100 bar state has |ΔP| ≈ 0 → no tag; the ambient outflow
# tail settles to |ΔP| ≈ 0 → no tag.  Only the wave itself refines.
amr.refinement_indicators = ptag
amr.ptag.field_name = pressure
amr.ptag.adjacent_difference_greater = 5.0e4
amr.ptag.max_level = 1

DistributionMapping.strategy = ROUNDROBIN

amr.checkpoint_files_output = 0
amr.check_file              = chk_amr
amr.check_int               = 500

amr.plot_files_output = 1
amr.plot_file         = plt_amr_
amr.plot_int          = 100
amr.derive_plot_vars  = x_velocity y_velocity z_velocity vfrac pressure

prob.p0    = 1.0e7
prob.T0    = 320.0
prob.u0    = 0.0
prob.p_amb = 1.0e5
