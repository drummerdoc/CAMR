# =====================================================================
#  T-Blowdown along x: closed end at x = 0, characteristic vent at x = 1
#
#  Closed 1 m pipe of supercritical CO2 at 100 bar, 320 K, vented at the
#  x-hi face to 1 bar.  The initial rarefaction runs to the closed wall,
#  reflects, and gives the wall-pressure history of a blowdown.  256 x 32
#  isotropic cells; a single plotfile at the end of the run.
#
#  Everything else comes from inputs.base.  max_step = 300 (from the
#  base) governs this deck: 300 steps at CFL 0.25 end well before the
#  stop_time of 5 ms set here, which is the time the full trajectory
#  needs (about 4000 steps).  Raise max_step on the command line to run
#  to stop_time.
# =====================================================================
FILE = inputs.base

stop_time = 5.0e-3

# 1 m pipe, isotropic cells (dx = dy).
geometry.prob_hi     =   1.0    0.125  0.125
amr.n_cell           =   256   32   32

# Closed pipe end at x-lo (SlipWall); x-hi is Inflow, which dispatches to
# the NSCBC outflow at p_amb.  Side walls SlipWall.
CAMR.lo_bc       =  SlipWall   SlipWall   SlipWall
CAMR.hi_bc       =  Inflow     SlipWall   SlipWall

# Final plotfile only.
amr.plot_file         = plt
amr.plot_int          = 100000
