# =====================================================================
#  inputs.base — T-Blowdown settings shared by every deck in this
#  directory.  Not run directly: each deck includes it with
#      FILE = inputs.base
#  and sets only what is orientation- or deck-specific:
#      amr.n_cell, geometry.prob_hi   (long axis of the tube)
#      CAMR.lo_bc, CAMR.hi_bc         (Inflow on the vent face, SlipWall elsewhere)
#      amr.plot_file                  (one prefix per deck)
#  inputs-x also overrides stop_time and amr.plot_int (a later
#  definition wins in ParmParse); inputs-x-amr is a standalone deck.
#  Everything non-directional (physics, CFL, NSCBC, plot machinery,
#  prob.*) lives here; an edit that is not about direction belongs
#  here, not in a deck.
#
#  A closed 1 m pipe of supercritical CO2 (100 bar, 320 K) vents through
#  one characteristic (NSCBC) outflow face to 1 bar.  max_step = 300 is
#  the step cap the orientation decks run under; stop_time is the time
#  cap.
# =====================================================================

amrex.fpe_trap_invalid = 0

max_step  = 300
stop_time = 1.65e-3

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  # 0 => Cartesian

# geometry.prob_lo / prob_hi + amr.n_cell are set per-orientation.
# The base always places prob_lo at the origin.
geometry.prob_lo     =   0.0    0.0    0.0

# CAMR.lo_bc / hi_bc are set per deck.  Exactly one face is Inflow
# (dispatched to the NSCBC outflow) and every other face is SlipWall
# (reflecting tube wall).

# --- Physics + numerics ---------------------------------------------
CAMR.cfl = 0.25
CAMR.fixed_dt = 0
CAMR.allow_negative_energy = 1
CAMR.do_mol = 0
CAMR.ppm_type = 1

CAMR.ps_hydro = 1
#  The flux is the compiled default (wp), written out so the deck
#  records the scheme it runs; ps_wp_order stays at its default (1).
CAMR.ps_flux  = wp
#  Characteristic (NSCBC) outflow on the Inflow face; the dispatch in
#  PS_nscbc.H (PS_NSCBC::outflow_face) serves any face, which is what
#  the orientation suite tests.
CAMR.ps_bc_use_nscbc = 1
CAMR.ps_bc_nscbc_sigma = 0.25

CAMR.v = 1
amr.v = 1
CAMR.sum_interval = -1
CAMR.redistribution_type = StateRedist

amr.loadbalance_with_workestimates = 0

amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 16
amr.n_error_buf     = 0 0 0 0
amr.grid_eff        = 0.99

DistributionMapping.strategy = ROUNDROBIN

amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = 500

amr.plot_files_output = 1
amr.plot_int          = 100
amr.derive_plot_vars  = x_velocity y_velocity z_velocity vfrac pressure

# --- Problem initial state -----------------------------------------
prob.p0    = 1.0e7    # Pa   (100 bar, initial pressure)
prob.T0    = 320.0    # K
prob.u0    = 0.0      # m/s
prob.p_amb = 1.0e5    # Pa   (atmospheric — target ambient at the vent)
