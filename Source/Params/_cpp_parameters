# name   type   default
#
# note, name can have two values, as (a, b).  a will be the name used
# in the inputs file, b is the variable name in the C++ class.

@namespace: CAMR CAMR static

#-----------------------------------------------------------------------------
# category: AMR
#-----------------------------------------------------------------------------

# if you are using radiation, choosing this to be zero will
# be overridden since radiation needs at least one ghost zone.
state_nghost                 int           0

# do we do the hyperbolic reflux at coarse-fine interfaces?
do_reflux                    int           1

# Should we refine on cut cells?
refine_cut_cells             int           0

#-----------------------------------------------------------------------------
# category: hydrodynamics
#-----------------------------------------------------------------------------

# the coefficient of the artificial viscosity
difmag                       Real          0.1

# Just a definition of "small"
small                        Real          1.e-8

# the small density cutoff.  Densities below this value will be reset
small_dens                   Real          1.e-7

# the small temperature cutoff.  Temperatures below this value will
# be reset
small_temp                   Real          1.e2

# the small pressure cutoff.  Pressures below this value will be reset
small_pres                   Real          1.e-200

# uses MOL aapproach to timestep advection and diffusion
do_mol                       int          0

# uses the Pelanti-Shyue six-equation wave-propagation solver
# (co2-eos-cfd integration Phase 4).  Requires the code to have
# been built with USE_PS_HYDRO = TRUE in the Exec GNUmakefile.
ps_hydro                     int          0

# PS_umeth reconstruction order.
#   0 = godunov (first-order, cell-centred).  Default.  Robust and
#       CFL-1 stable.
#   1 = muscl   (second-order slope-limited PLM, minmod, on the
#       conservative U slots as in the standalone WP driver).
#       Halves the stable CFL to ~0.5.  Enable with
#           CAMR.ps_recon = 1
#       and drop CAMR.fixed_dt or CAMR.cfl accordingly.
ps_recon                     int          0

# Limiter for the high-resolution WP-α₁ transport correction (the
# 2nd-order van-Leer/minmod flux limiter on the non-conservative α₁
# advection in PS_umeth's WP-α kernel).
#   vanleer = van Leer (DEFAULT).  Validated stable + 2nd-order-in-space
#             on B4-Cross-critical and the CO2_ADV2D smooth advection.
#   minmod  = minmod.  DIVERGES on B4 (spurious contact velocity spike
#             that blows up by ~step 60) — available for study only.
# See docs/design/camr_ps_alpha_transport_map.md.
ps_alpha_limiter             string       "vanleer"

# PS-mode non-reflecting outflow: NSCBC (Poinsot-Lele 1992) applied
# via BCfill.cpp for boundary faces flagged CAMR.hi_bc = Inflow (the
# characteristic-BC dispatch route).  When 0, the older single-cell
# linearised Riemann-invariant path in prob.H::bcnormal is used.
ps_bc_use_nscbc              int          0

# NSCBC pressure-relaxation coefficient (Poinsot-Lele σ).  0 gives
# perfectly non-reflecting (allows slow pressure drift over long
# runs); 0.25 is the classical soft-relaxation default that anchors
# the boundary pressure to the ambient without measurably reflecting
# outgoing waves.  Rieper (2011) (1 − M²) compressibility factor is
# always applied on top.
ps_bc_nscbc_sigma            Real         0.25

# ---------------------------------------------------------------------
# Phase 4g two-phase source dials (mirror the standalone driver's env
# vars).  ALL default OFF/disabled → no physics change vs pre-4g.  Each
# gates a per-cell post-hydro source in ps_apply_sources (PS_sources.H).
# ---------------------------------------------------------------------
# Flash nucleation relaxation timescale (standalone PS_FLASH_TAU).
# 0 = disabled.  >0 enables ps_flash_source_cell (Wagner Psat) — task 4g-2.
ps_flash_tau                 Real         1.0e-7

# Finite-rate mass-transfer timescale (standalone PS_MT_TAU).
# 0 = instantaneous Newton (current behaviour).  >0 enables the
# finite-rate ps_mass_transfer_finite_cell — task 4g-4.
ps_mt_tau                    Real         1.0e-7

# Triple-point / solid-CO2 avoidance action (standalone
# PS_TRIPLE_POINT_ACTION).  0=OFF, 1=WARN, 2=CLIP, 3=ERROR — task 4g-3.
ps_triple_point_action       int          0

# Berger-LeVeque fluctuation-form coarse-fine reflux for the PS
# NON-conservative terms (α transport + WP phase-energy defect).
# 0 = off (default; only the standard conservative FluxRegister runs).
# 1 = also run the parallel fluctuation register + reflux fix-up.
# See docs/design/camr_ps_bl_reflux_design.md (task #22).
ps_bl_reflux                 int          0

# React fuel + air -> product
do_react                     int          0

# if true, define an additional source term
add_ext_src                  int           0

# if true, define a gravity source term
add_grav_src                 int           1

# if true, define a gravity source term
const_grav                   Real           0.0

# reconstruction type:
# 0: piecewise linear;
# 1: classic Colella \& Woodward ppm;
# 2: extrema-preserving ppm (deprecated in C++)
ppm_type                     int           0

# to we reconstruct and trace under the parabolas of the source
# terms to the velocity
ppm_trace_sources            int           0

# for piecewise linear, reconstruction order to use
plm_iorder                   int           4

# flatten the reconstructed profiles around shocks to prevent them
# from becoming too thin
use_flattening               int           1

# Allow internal energy resets and temperature flooring to change the
# total energy variable UEDEN in addition to the internal energy variable
# UEINT.
dual_energy_update_E_from_e  int           1

# Threshold value of (E - K) / E such that above eta1, the hydrodynamic
# pressure is derived from E - K; otherwise, we use the internal energy
# variable UEINT.
dual_energy_eta1             Real          1.0e0

# Threshold value of (E - K) / E such that above eta2, we update the
# internal energy variable UEINT to match E - K. Below this, UEINT
# remains unchanged.
dual_energy_eta2             Real          1.0e-4

# for the piecewise linear reconstruction, do we subtract off $(\rho g)$
# from the pressure before limiting?
use_pslope                   int           0

# Whether or not to allow internal energy to be less than zero
allow_negative_energy        int           0

# Whether or not to allow the internal energy to be less than the
# internal energy corresponding to small\_temp
allow_small_energy           int           1

# Do we reset density inside the hydro update if the transverse contributions
# make it go negative
transverse_reset_density     int           1

#-----------------------------------------------------------------------------
# category: EB
#-----------------------------------------------------------------------------
eb_weights_type              int          2
redistribution_type          string       "FluxRedist"

#-----------------------------------------------------------------------------
# category: timestep control
#-----------------------------------------------------------------------------

# a fixed timestep to use for all steps (negative turns it off)
fixed_dt                     Real         -1.0

# the initial timestep (negative uses the step returned from the timestep
# constraints)
initial_dt                   Real         -1.0

# the smallest valid timestep---if we go below this, we abort
dt_cutoff                    Real          0.0

# the largest valid timestep---limit all timesteps to be no larger than this
max_dt                       Real          1.e200

# the effective Courant number to use---we will not allow the hydrodynamic
# waves to cross more than this fraction of a zone over a single timestep
cfl                          Real          0.8

# a factor by which to reduce the first timestep from that requested by
# the timestep estimators
init_shrink                  Real          1.0

# the maximum factor by which the timestep can increase from one step to
# the next.
change_max                   Real          1.1

#-----------------------------------------------------------------------------
# category: parallelization
#-----------------------------------------------------------------------------

bndry_func_thread_safe       int           1

#-----------------------------------------------------------------------------
# category: diagnostics
#-----------------------------------------------------------------------------

# how often (number of coarse timesteps) to compute integral sums (for runtime diagnostics)
sum_interval                 int           -1

# how often (simulation time) to compute integral sums (for runtime diagnostics)
sum_per                      Real          -1.0e0

# a string describing the simulation that will be copied into the
# plotfile's {\tt job\_info} file
job_name                     string        ""

# Should we write the geometry into vtk files?
write_eb                     int           0
